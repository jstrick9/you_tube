# Copy to .env (self-hosted) or add each as a GitHub Actions secret.
# Only ONE LLM key is needed; more keys = more failover headroom. All are free.

# ── LLM (at least one recommended; keyless fallback exists but is slow/limited)
GEMINI_API_KEY=          # https://aistudio.google.com/apikey
GROQ_API_KEY=            # https://console.groq.com/keys
OPENROUTER_API_KEY=      # https://openrouter.ai/keys

# ── Media (optional; Wikimedia/Openverse work without a key)
PEXELS_API_KEY=          # https://www.pexels.com/api/

# ── YouTube (required for uploading)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=        # from scripts/get_refresh_token.py
YOUTUBE_API_KEY=         # optional: adds YouTube's trending chart as a trend source

# ── Notifications (optional)
NTFY_TOPIC=              # e.g. autotube-yourname-8f3k  → install the ntfy app and subscribe
DISCORD_WEBHOOK_URL=
